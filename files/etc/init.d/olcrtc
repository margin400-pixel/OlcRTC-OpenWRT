#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

validate_section_olcrtc() {
	uci_get_by_type() {
		local type="$1"
		local option="$2"
		local default="$3"
		uci -q get olcrtc.@$type[0].$option 2>/dev/null || echo "$default"
	}

	local enabled=$(uci_get_by_type global enabled 0)
	[ "$enabled" = "1" ] || return 1

	local provider=$(uci_get_by_type global provider "jitsi")
	local transport=$(uci_get_by_type global transport "datachannel")
	local jitsi_url=$(uci_get_by_type global jitsi_url "https://meet.small-dm.ru")
	local room_id=$(uci_get_by_type global room_id "")
	local key=$(uci_get_by_type global key "")
	local vp8_fps=$(uci_get_by_type global vp8_fps "30")
	local vp8_batch=$(uci_get_by_type global vp8_batch "64")
	local video_w=$(uci_get_by_type global video_w "1080")
	local video_h=$(uci_get_by_type global video_h "1080")
	local video_bitrate=$(uci_get_by_type global video_bitrate "5000k")
	local socks_host=$(uci_get_by_type global socks_host "127.0.0.1")
	local socks_port=$(uci_get_by_type global socks_port "1080")

	[ -z "$room_id" ] || [ -z "$key" ] && return 1

	# Генерируем YAML конфиг для актуального OlcRTC
	cat << YAMLEOF > /tmp/olcrtc.yaml
mode: cnc
provider: $provider
transport: $transport
jitsi:
  url: "$jitsi_url"
  room: "$room_id"
  key: "$key"
video:
  width: $video_w
  height: $video_h
  bitrate: "$video_bitrate"
vp8:
  fps: $vp8_fps
  batch: $vp8_batch
socks:
  host: "$socks_host"
  port: $socks_port
YAMLEOF
	return 0
}

start_service() {
	validate_section_olcrtc || {
		echo "OlcRTC: Не включен или не настроен (проверьте room_id и key)"
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/bin/olcrtc /tmp/olcrtc.yaml
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/olcrtc.yaml
	procd_kill olcrtc
}

restart() {
	stop
	sleep 2
	start
}
